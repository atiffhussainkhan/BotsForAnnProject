# Production secrets belong in the hosting service's private environment.
# Local drafts work without provider credentials.
HOST=127.0.0.1
PORT=8080
ARAIM_PUBLIC_ORIGIN=
ARAIM_OWNER_USERNAME=owner
ARAIM_OWNER_PASSWORD=
ARAIM_MASTER_KEY=
ARAIM_DB_PATH=data/database/ann_reveals_manager.db
ARAIM_BACKUP_DIR=data/backups
ARAIM_DEMO_MODE=false

# Official TikTok Business Accounts credentials, after provider approval.
TIKTOK_BUSINESS_APP_ID=
TIKTOK_BUSINESS_OPEN_ID=
TIKTOK_BUSINESS_ACCESS_TOKEN=
TIKTOK_BUSINESS_WEBHOOK_SECRET=
TIKTOK_WRITE_ENABLED=false
INSTAGRAM_WRITE_ENABLED=false
THIRD_PARTY_AUTOCOMMENT=false
