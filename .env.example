# ==============================================================================
# Ann Reveals AI Manager (ARAIM v4.0) — Environment Configuration Template
# Copy to `.env` and populate with your production values.
# NEVER commit real secrets to Git.
# ==============================================================================

# --- Core Application & Owner Identity ---
APP_NAME="Ann Reveals AI Manager"
APP_ENV="production"
PORT=8000
OWNER_HANDLE="@annreveals"

# --- Strict Account-Safety Feature Flags (NFR-09: MUST default to false) ---
TIKTOK_WRITE_ENABLED=false
INSTAGRAM_WRITE_ENABLED=false
THIRD_PARTY_AUTOCOMMENT=false

# --- Cryptographic Master Keys & Session Security (NFR-05) ---
ARAIM_MASTER_KEY="replace-with-32-byte-high-entropy-master-key-in-prod"
ARAIM_MASTER_KEY_ID="k1"
ARAIM_CSRF_SECRET="replace-with-32-byte-csrf-signing-secret"
ARAIM_OAUTH_STATE_SECRET="replace-with-32-byte-oauth-state-signing-secret"

# --- Hard Monthly Budget Guard (FR-039, FR-050, NFR-07) ---
MONTHLY_BUDGET_CAP_GBP=30.00
AI_MONTHLY_SUBCAP_GBP=5.00
HOSTING_MONTHLY_GBP=7.00
STORAGE_MONTHLY_GBP=0.50

# --- Official Instagram Graph API (Agent Bravo) ---
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="https://annreveals.app/api/oauth/instagram/callback"

# --- Official TikTok API v2 (Agent Alpha) ---
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_WEBHOOK_SECRET=""
TIKTOK_REDIRECT_URI="https://annreveals.app/api/oauth/tiktok/callback"

# --- UK GDPR Retention Windows (NFR-06) ---
COMMENT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
EVIDENCE_RETENTION_DAYS=730
